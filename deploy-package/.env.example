# Required: your Neon (or any PostgreSQL) connection string
NEON_DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Required: random secret string for session cookies (generate with: openssl rand -hex 32)
SESSION_SECRET=replace-with-a-long-random-secret

# Optional: set to 'production'
NODE_ENV=production

# Optional: port (cPanel Node.js apps usually set this automatically)
PORT=3000
